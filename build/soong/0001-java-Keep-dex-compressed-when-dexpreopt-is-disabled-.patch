From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FPSensor <gkartyt@gmail.com>
Date: Mon, 16 Nov 2026 07:25:37 +0000
Subject: [PATCH] java: Keep dex compressed when dexpreopt is disabled globally

dexpreoptDisabled() only checks per-module conditions, so with
WITH_DEXPREOPT := false every app still stored its dex uncompressed
although nothing gets preopted.

Change-Id: I3cfd64a02d6d14f35a8dad275938cc02c5c49091
---
 java/java.go       | 4 +++-
 ui/build/config.go | 8 +++++++-
 ui/build/rbe.go    | 4 ++--
 3 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/java/java.go b/java/java.go
index e52fc1996..01b254b8d 100644
--- a/java/java.go
+++ b/java/java.go
@@ -954,7 +954,9 @@ func shouldUncompressDex(ctx android.ModuleContext, libName string, dexpreopter
 	}
 
 	// Store uncompressed dex files that are preopted on /system or /system_other.
-	if !dexpreopter.dexpreoptDisabled(ctx, libName) {
+	// With dexpreopt disabled globally (WITH_DEXPREOPT := false) nothing is
+	// preopted, so keep them compressed.
+	if !dexpreopter.dexpreoptDisabled(ctx, libName) && !dexpreopt.GetGlobalConfig(ctx).DisablePreopt {
 		return true
 	}
 
diff --git a/ui/build/config.go b/ui/build/config.go
index 1d793ad45..a5ae89aae 100644
--- a/ui/build/config.go
+++ b/ui/build/config.go
@@ -1834,7 +1834,13 @@ func (c *configImpl) KatiBin() string {
 	return c.PrebuiltBuildTool(binName)
 }
 
-func (c *configImpl) NinjaBin() string {
+func (c *configImpl) NinjaBin() string {/* SRA custom ninja begin */
+	if customNinja, ok := c.environ.Get("CUSTOM_NINJA_BIN"); ok && customNinja != "" {
+		return customNinja
+	} else if !ok {
+		return "/opt/ninja"
+	}
+/* SRA custom ninja end */
 	binName := "ninja"
 	if c.UseABFS() {
 		binName = "ninjago"
diff --git a/ui/build/rbe.go b/ui/build/rbe.go
index 8f99b147c..9f7a20091 100644
--- a/ui/build/rbe.go
+++ b/ui/build/rbe.go
@@ -119,7 +119,7 @@ func startRBE(ctx Context, config Config) {
 	e := ctx.BeginTrace(metrics.RunSetupTool, "rbe_bootstrap")
 	defer e.End()
 
-	ctx.Status.Status("Starting rbe...")
+	ctx.Status.Status("Starting ninja...")
 
 	cmd := Command(ctx, config, e, "startRBE bootstrap", rbeCommand(ctx, config, bootstrapCmd))
 
@@ -132,7 +132,7 @@ func stopRBE(ctx Context, config Config) {
 	cmd := Command(ctx, config, nil, "stopRBE bootstrap", rbeCommand(ctx, config, bootstrapCmd), "-shutdown")
 	output, err := cmd.CombinedOutput()
 	if err != nil {
-		ctx.Fatalf("rbe bootstrap with shutdown failed with: %v\n%s\n", err, output)
+		ctx.Fatalf("soong bootstrap with shutdown failed with: %v\n%s\n", err, output)
 	}
 
 	if !config.Environment().IsEnvTrue("ANDROID_QUIET_BUILD") && len(output) > 0 {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FPSensor <gkartyt@gmail.com>
Date: Tue, 17 Nov 2026 18:07:31 +0000
Subject: [PATCH] keystore2: Look up the caller context without binder security
 contexts

Kernels older than 4.20 don't support TXN_SECURITY_CTX, so calling_sid
was always missing and every permission check failed, taking
system_server down at boot. Fall back to getpidcon() on the calling pid,
like servicemanager, instead of skipping the checks.

Change-Id: Idb32fcd8b069e100b0750f65df8f3c3a82e01018
---
 keystore2/selinux/src/lib.rs | 25 +++++++++++++++++++
 keystore2/src/utils.rs       | 47 +++++++++++++++---------------------
 2 files changed, 45 insertions(+), 27 deletions(-)

diff --git a/keystore2/selinux/src/lib.rs b/keystore2/selinux/src/lib.rs
index cebe8986..e74b841c 100644
--- a/keystore2/selinux/src/lib.rs
+++ b/keystore2/selinux/src/lib.rs
@@ -246,6 +246,31 @@ pub fn getcon() -> Result<Context> {
     }
 }
 
+/// Safe wrapper around libselinux `getpidcon`. It initializes the `Context::Raw` variant of the
+/// returned `Context`.
+///
+/// ## Return
+///  * Ok(Context::Raw()) if successful.
+///  * Err(Error::sys()) if getpidcon succeeded but returned a NULL pointer.
+///  * Err(io::Error::last_os_error()) if getpidcon failed.
+pub fn getpidcon(pid: selinux::pid_t) -> Result<Context> {
+    init_logger_once();
+    let _lock = LIB_SELINUX_LOCK.lock().unwrap();
+
+    let mut con: *mut c_char = ptr::null_mut();
+    // SAFETY: getpidcon only writes a newly allocated context to `con`.
+    match unsafe { selinux::getpidcon(pid, &mut con) } {
+        0 => {
+            if !con.is_null() {
+                Ok(Context::Raw(con))
+            } else {
+                Err(anyhow!(Error::sys("getpidcon returned a NULL context")))
+            }
+        }
+        _ => Err(anyhow!(io::Error::last_os_error())).context("getpidcon failed"),
+    }
+}
+
 /// Safe wrapper around selinux_check_access.
 ///
 /// ## Return
diff --git a/keystore2/src/utils.rs b/keystore2/src/utils.rs
index 6816241f..f75bfe3a 100644
--- a/keystore2/src/utils.rs
+++ b/keystore2/src/utils.rs
@@ -19,6 +19,7 @@ use crate::error::{map_binder_status, map_km_error, Error, ErrorCode};
 use crate::key_parameter::KeyParameter;
 use crate::ks_err;
 use crate::permission;
+use std::ffi::CStr;
 use crate::permission::{KeyPerm, KeyPermSet, KeystorePerm};
 pub use crate::watchdog_helper::watchdog;
 use crate::{
@@ -112,33 +113,33 @@ pub struct Challenge(pub i64);
 /// 999912312359559, which is 253402300799000 ms from Jan 1, 1970.
 pub const UNDEFINED_NOT_AFTER: i64 = 253402300799000i64;
 
+/// Calls `f` with the SELinux context of the binder caller. Kernels without
+/// binder security contexts (Linux < 4.20, no TXN_SECURITY_CTX) never send
+/// it: look it up by the calling pid there, like servicemanager does.
+fn with_caller_context<T>(f: impl FnOnce(&CStr) -> anyhow::Result<T>) -> anyhow::Result<T> {
+    ThreadState::with_calling_sid(|calling_sid| match calling_sid {
+        Some(sid) => f(sid),
+        None => {
+            let context = keystore2_selinux::getpidcon(ThreadState::get_calling_pid())
+                .context(ks_err!("Cannot check permission without calling_sid."))?;
+            f(&context)
+        }
+    })
+}
+
 /// This function uses its namesake in the permission module and in
 /// combination with with_calling_sid from the binder crate to check
 /// if the caller has the given keystore permission.
 pub fn check_keystore_permission(perm: KeystorePerm) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_keystore_permission(
-            calling_sid
-                .ok_or_else(Error::sys)
-                .context(ks_err!("Cannot check permission without calling_sid."))?,
-            perm,
-        )
-    })
+    with_caller_context(|sid| permission::check_keystore_permission(sid, perm))
 }
 
 /// This function uses its namesake in the permission module and in
 /// combination with with_calling_sid from the binder crate to check
 /// if the caller has the given grant permission.
 pub fn check_grant_permission(access_vec: KeyPermSet, key: &KeyDescriptor) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_grant_permission(
-            AppUid::calling(),
-            calling_sid
-                .ok_or_else(Error::sys)
-                .context(ks_err!("Cannot check permission without calling_sid."))?,
-            access_vec,
-            key,
-        )
+    with_caller_context(|sid| {
+        permission::check_grant_permission(AppUid::calling(), sid, access_vec, key)
     })
 }
 
@@ -150,16 +151,8 @@ pub fn check_key_permission(
     key: &KeyDescriptor,
     access_vector: &Option<KeyPermSet>,
 ) -> anyhow::Result<()> {
-    ThreadState::with_calling_sid(|calling_sid| {
-        permission::check_key_permission(
-            AppUid::calling(),
-            calling_sid
-                .ok_or_else(Error::sys)
-                .context(ks_err!("Cannot check permission without calling_sid."))?,
-            perm,
-            key,
-            access_vector,
-        )
+    with_caller_context(|sid| {
+        permission::check_key_permission(AppUid::calling(), sid, perm, key, access_vector)
     })
 }
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FPSensor <gkartyt@gmail.com>
Date: Mon, 16 Nov 2026 13:48:50 +0000
Subject: [PATCH] hwservicemanager: Don't abort without binder security
 contexts

Kernels older than 4.20 don't support TXN_SECURITY_CTX. Fall back to
getpidcon() instead of aborting.

Change-Id: If51b0eb3a0fd2b31f9ed31f0ea48506535c1669f
---
 ServiceManager.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ServiceManager.cpp b/ServiceManager.cpp
index 73582d2..3c39abc 100644
--- a/ServiceManager.cpp
+++ b/ServiceManager.cpp
@@ -47,8 +47,8 @@ AccessControl::CallingContext getBinderCallingContext() {
             android_errorWriteLog(0x534e4554, "121035042");
         }
 
-        CHECK_EQ(nullptr, self->getServingStackPointer())
-                << "Pid " << pid << " missing service context.";
+        // Kernels without binder security contexts never send them; fall
+        // back to getpidcon() instead of aborting.
 
         return AccessControl::getCallingContext(pid);
     } else {

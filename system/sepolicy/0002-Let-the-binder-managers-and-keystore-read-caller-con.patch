From 076511613a3c243ae75d4a051b849f537755f875 Mon Sep 17 00:00:00 2001
From: FPSensor <gkartyt@gmail.com>
Date: Tue, 17 Nov 2026 18:54:44 +0000
Subject: [PATCH] Let the binder managers and keystore read caller contexts
 from /proc

Kernels without binder security contexts (Linux < 4.20) never send the
caller's context, so servicemanager, hwservicemanager, vndservicemanager
and keystore2 look it up with getpidcon(), which reads
/proc/<pid>/attr/current.

Change-Id: I7f0b1290eaa91d813d3121ba759567d8eae0871b
---
 private/hwservicemanager.te | 7 +++++++
 private/keystore.te         | 7 +++++++
 private/servicemanager.te   | 7 +++++++
 vendor/vndservicemanager.te | 7 +++++++
 4 files changed, 28 insertions(+)

diff --git a/private/hwservicemanager.te b/private/hwservicemanager.te
index 5605c4d7c..6a7569a18 100644
--- a/private/hwservicemanager.te
+++ b/private/hwservicemanager.te
@@ -30,3 +30,10 @@ allow hwservicemanager hwservice_contexts_file:file r_file_perms;
 
 # Check SELinux permissions.
 selinux_check_access(hwservicemanager)
+
+# Kernels without binder security contexts (Linux < 4.20, no
+# TXN_SECURITY_CTX) never send the caller's context, so hwservicemanager looks it up
+# in /proc/<pid>/attr/current with getpidcon().
+allow hwservicemanager domain:dir search;
+allow hwservicemanager domain:file r_file_perms;
+allow hwservicemanager domain:process getattr;
diff --git a/private/keystore.te b/private/keystore.te
index ebf807535..6898d2b88 100644
--- a/private/keystore.te
+++ b/private/keystore.te
@@ -108,3 +108,10 @@ neverallow * keystore:process ptrace;
 # Only keystore can set keystore_diagnostics_prop system properties. Since init is allowed to set
 # any system property, an exception is added for init as well.
 neverallow { domain -keystore -init } keystore_diagnostics_prop:property_service set;
+
+# Kernels without binder security contexts (Linux < 4.20, no
+# TXN_SECURITY_CTX) never send the caller's context, so keystore looks it up
+# in /proc/<pid>/attr/current with getpidcon().
+allow keystore domain:dir search;
+allow keystore domain:file r_file_perms;
+allow keystore domain:process getattr;
diff --git a/private/servicemanager.te b/private/servicemanager.te
index 6764b451f..c7930c74c 100644
--- a/private/servicemanager.te
+++ b/private/servicemanager.te
@@ -50,3 +50,10 @@ recovery_only(`
   # Read VINTF files.
   r_dir_file(servicemanager, rootfs)
 ')
+
+# Kernels without binder security contexts (Linux < 4.20, no
+# TXN_SECURITY_CTX) never send the caller's context, so servicemanager looks it up
+# in /proc/<pid>/attr/current with getpidcon().
+allow servicemanager domain:dir search;
+allow servicemanager domain:file r_file_perms;
+allow servicemanager domain:process getattr;
diff --git a/vendor/vndservicemanager.te b/vendor/vndservicemanager.te
index 2ad050216..2a1ca6707 100644
--- a/vendor/vndservicemanager.te
+++ b/vendor/vndservicemanager.te
@@ -23,3 +23,10 @@ selinux_check_access(vndservicemanager)
 
 # Log to kmesg
 allow vndservicemanager kmsg_device:chr_file rw_file_perms;
+
+# Kernels without binder security contexts (Linux < 4.20, no
+# TXN_SECURITY_CTX) never send the caller's context, so vndservicemanager looks it up
+# in /proc/<pid>/attr/current with getpidcon().
+allow vndservicemanager domain:dir search;
+allow vndservicemanager domain:file r_file_perms;
+allow vndservicemanager domain:process getattr;
-- 
